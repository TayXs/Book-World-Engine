# Required: verification and explanation run on the Claude API.
ANTHROPIC_API_KEY=sk-ant-...

# Model + effort. Opus 5 is the default; effort trades cost against thoroughness.
TRUTHCAST_MODEL=claude-opus-5
TRUTHCAST_EFFORT=high

# How strict the verifier is before a claim is allowed into your digest.
TRUTHCAST_MIN_CONFIDENCE=0.75
TRUTHCAST_MIN_INDEPENDENT_SOURCES=2
TRUTHCAST_MAX_CLAIMS=25
TRUTHCAST_TARGET_READING_GRADE=5.0

# Include a short "the video got this wrong" section built only from
# claims that were disproven with the same evidence bar. Set to false for
# verified-true facts only.
TRUTHCAST_INCLUDE_CORRECTIONS=true

# Text to speech: browser | elevenlabs | openai
# "browser" needs no key and no network - the web player speaks the digest locally.
TRUTHCAST_TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy

# Where jobs, transcripts and generated audio live.
TRUTHCAST_DATA_DIR=./data
